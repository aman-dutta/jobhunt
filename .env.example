# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/[your-project]/settings/api

# Supabase Project URL
# Format: https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable Default Key (NEW API - client-side safe)
# Starts with "sb_publishable_"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your-publishable-key

# Next.js Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3090

# ====================================
# 🎯 LOGO.DEV CONFIGURATION
# ====================================
# Logo.dev API for company logos - https://logo.dev
# Get API keys from: https://logo.dev/dashboard

# Public key (safe for client-side usage)
# Starts with "pk_"
NEXT_PUBLIC_LOGO_DEV_KEY=pk_your-publishable-key

# Secret key (server-side only, for API routes if needed)
# Starts with "sk_"
LOGO_DEV_SECRET_KEY=sk_your-secret-key

# ====================================
# 📧 EMAIL NOTIFICATION CONFIGURATION
# ====================================
# Option 1: Gmail SMTP (100% Free, No domain needed, sends to you & your friends)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=abcd-efgh-ijkl-mnop

# Option 2: Resend API (Alternative)
# Get your free API key at: https://resend.com
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL="JobHunt <onboarding@resend.dev>"

